rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is admin (matches whitelisted phone number or email)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.phone_number == '+919501825673' || 
        request.auth.token.email == 'ishankumax@gmail.com'
      );
    }

    match /links/{link} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogs/{blog} {
      // Public can only read published blogs. Admins can read all.
      allow read: if (resource.data.is_published == true) || isAdmin();
      allow write: if isAdmin();
    }
    
    match /content_blocks/{block} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /short_links/{slug} {
      allow read: if true;
      allow create: if true;
      // Allow incrementing click count
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']);
    }
    
    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
